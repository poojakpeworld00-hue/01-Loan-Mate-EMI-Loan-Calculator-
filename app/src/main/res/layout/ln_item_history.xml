<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_10sdp"
    android:background="@drawable/ln_bg_history_card"
    android:padding="@dimen/_14sdp">

    <!-- Title + date -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ln_sfprodisplaybold"
        android:textColor="@color/ln_brand_primary"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintEnd_toStartOf="@id/btnView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Loan Calculator" />

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:fontFamily="@font/ln_sf_pro"
        android:textColor="@color/ln_text_tertiary"
        android:textSize="@dimen/_11ssp"
        app:layout_constraintEnd_toStartOf="@id/btnView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        tools:text="2026-4-27" />

    <!-- Action buttons -->
    <FrameLayout
        android:id="@+id/btnView"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:background="@drawable/ln_bg_circle_eye"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toStartOf="@id/btnDelete"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:layout_gravity="center"
            android:contentDescription="@string/ln_cd_history_view"
            android:src="@drawable/ln_ic_eye"
            app:tint="@color/ln_brand_primary" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btnDelete"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:background="@drawable/ln_bg_circle_trash"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:layout_gravity="center"
            android:contentDescription="@string/ln_cd_history_delete"
            android:src="@drawable/ln_ic_trash"
            app:tint="@color/ln_grid_red_fg" />
    </FrameLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@color/ln_divider"
        app:layout_constraintTop_toBottomOf="@id/tvDate" />

    <!-- 3 columns: INTEREST | DURATION | LOAN AMOUNT (right-aligned) -->
    <LinearLayout
        android:id="@+id/colInterest"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/colDuration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ln_sf_pro_semibold"
            android:letterSpacing="0.05"
            android:text="@string/ln_history_col_interest"
            android:textColor="@color/ln_text_tertiary"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:id="@+id/tvInterest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:textColor="@color/ln_text_primary"
            android:textSize="@dimen/_13ssp"
            tools:text="5%" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/colDuration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/colAmount"
        app:layout_constraintStart_toEndOf="@id/colInterest"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ln_sf_pro_semibold"
            android:letterSpacing="0.05"
            android:text="@string/ln_history_col_duration"
            android:textColor="@color/ln_text_tertiary"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:textColor="@color/ln_text_primary"
            android:textSize="@dimen/_13ssp"
            tools:text="5 Years" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/colAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ln_sf_pro_semibold"
            android:gravity="end"
            android:letterSpacing="0.05"
            android:text="@string/ln_history_col_amount"
            android:textColor="@color/ln_text_tertiary"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:textColor="@color/ln_brand_primary"
            android:textSize="@dimen/_13ssp"
            tools:text="5000" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
