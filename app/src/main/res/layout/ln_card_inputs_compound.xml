<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_14sdp"
    android:background="@drawable/ln_bg_summary_card"
    android:orientation="vertical"
    android:padding="@dimen/_14sdp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ln_sf_pro_semibold"
        android:text="@string/ln_ci_interest_compounded"
        android:textColor="@color/ln_text_primary"
        android:textSize="@dimen/_12ssp" />

    <Spinner
        android:id="@+id/spinnerCompounding"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:background="@drawable/ln_bg_dropdown_field"
        android:paddingHorizontal="@dimen/_10sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/ln_sf_pro_semibold"
        android:text="@string/ln_ci_principal_amount"
        android:textColor="@color/ln_text_primary"
        android:textSize="@dimen/_12ssp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:background="@drawable/ln_bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp">

        <EditText
            android:id="@+id/etPrincipal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/ln_sf_pro_medium"
            android:hint="@string/ln_ci_enter_here"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvPrincipalSymbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ln_sf_pro_semibold"
            android:textColor="@color/ln_brand_primary"
            android:textSize="@dimen/_12ssp"
            tools:text="$" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/ln_sf_pro_semibold"
        android:text="@string/ln_ci_rate_per_year"
        android:textColor="@color/ln_text_primary"
        android:textSize="@dimen/_12ssp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:background="@drawable/ln_bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp">

        <EditText
            android:id="@+id/etRate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/ln_sf_pro_medium"
            android:hint="@string/ln_ci_enter_here"
            android:imeOptions="actionNext"
            android:inputType="numberDecimal"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ln_sf_pro_semibold"
            android:text="@string/ln_calc_unit_pct_short"
            android:textColor="@color/ln_brand_primary"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/ln_sf_pro_semibold"
        android:text="@string/ln_ci_times_in_year"
        android:textColor="@color/ln_text_primary"
        android:textSize="@dimen/_12ssp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:background="@drawable/ln_bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp">

        <EditText
            android:id="@+id/etTimes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/ln_sf_pro_medium"
            android:hint="@string/ln_ci_enter_here"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:background="@drawable/ln_bg_btn_primary"
        android:fontFamily="@font/ln_sf_pro_semibold"
        android:gravity="center"
        android:text="@string/ln_calc_action_calculate"
        android:textColor="@color/ln_text_on_primary"
        android:textSize="@dimen/_13ssp" />

    <TextView
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/ln_sf_pro_semibold"
        android:gravity="center"
        android:text="@string/ln_calc_action_reset"
        android:textColor="@color/ln_brand_primary"
        android:textSize="@dimen/_13ssp" />
</LinearLayout>
