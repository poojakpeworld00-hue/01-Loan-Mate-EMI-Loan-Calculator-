<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding, Claude Design "Loan Cash" flow: light wash, gradient icon tile header, white option cards, blue Continue. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ob_screen_bg">

    <!-- The header's faint loader arcs, top end (design watermark). -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/glowVw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="-30dp"
        android:alpha="0.12"
        android:importantForAccessibility="no"
        android:progress="74"
        app:indicatorColor="@color/ob_accent"
        app:indicatorSize="84dp"
        app:indicatorTrackGapSize="6dp"
        app:trackColor="#803399FF"
        app:trackCornerRadius="5dp"
        app:trackThickness="8dp" />

    <LinearLayout
        android:id="@+id/contentVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/backVw"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/glyph_back"
                app:tint="@color/ob_ink" />

            <LinearLayout
                android:id="@+id/trackerVw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/stepNumVw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ob_pill"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/ob_accent_deep"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stepNameVw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/ob_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stepTotalVw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/ob_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/skipVw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:minHeight="40dp"
                android:paddingHorizontal="8dp"
                android:text="@string/skip"
                android:textColor="@color/ob_muted"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/progFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="6dp">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/prog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="9"
                app:indicatorColor="@color/ob_accent"
                app:indicatorTrackGapSize="0dp"
                app:trackColor="@color/ob_track"
                app:trackCornerRadius="2dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="4dp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bodyVw"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp">

                    <ImageView
                        android:id="@+id/stepIconVw"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ob_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="13dp"
                        app:tint="@color/white" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-3dp"
                        android:layout_marginEnd="-3dp"
                        android:background="@drawable/ob_tile_dot" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleVw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.025"
                        android:lineSpacingMultiplier="1.05"
                        android:textAlignment="viewStart"
                        android:textColor="@color/ob_ink"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/subVw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textAlignment="viewStart"
                        android:textColor="@color/ob_muted"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/favRowVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/favCountVw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ob_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/ob_accent_deep"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/favAllVw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="36dp"
                    android:textColor="@color/ob_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listVw"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <include
                android:id="@+id/homeDemoVw"
                layout="@layout/piece_base_showcase"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/ctaVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextVw"
                style="@style/OB.Cta"
                android:layout_width="match_parent" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/adSlotVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:layout_marginBottom="3dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
