<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding option card (design Loan Type / Employment tiles): icon tile, name, description, check ring top end. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/ob_card"
    android:minHeight="132dp">

    <LinearLayout
        android:id="@+id/captionsVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/wellVw"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ob_tile_big">

            <ImageView
                android:id="@+id/imageVw"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/watermarkVw"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:textColor="@color/ob_tile_glyph"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/nameVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/ob_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subTextVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/ob_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ob_check" />
</FrameLayout>
