<?xml version="1.0" encoding="utf-8"?>
<!-- Splash, "Splash Loader" blue tile: gradient logo tile with a ring loader, name and tagline, rotating status line, progress bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ob_splash_bg">

    <LinearLayout
        android:id="@+id/contentVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.2" />

        <FrameLayout
            android:id="@+id/logoVw"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:clipChildren="false">

            <View
                android:id="@+id/glowVw"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:background="@drawable/ob_glow" />

            <View
                android:id="@+id/ring1Vw"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/ob_halo" />

            <View
                android:id="@+id/ring2Vw"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/ob_halo" />

            <FrameLayout
                android:id="@+id/tileVw"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ob_logo_tile"
                android:elevation="10dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/ringVw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="100"
                    app:indicatorColor="@color/white"
                    app:indicatorSize="58dp"
                    app:indicatorTrackGapSize="4dp"
                    app:trackColor="@color/ob_tile_soft"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="%"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/nameVw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="-0.015"
            android:text="@string/launcher_name"
            android:textColor="@color/ob_ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tagVw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.02"
            android:text="@string/splash_tagline"
            android:textColor="@color/ob_muted"
            android:textSize="14sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/bottomVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/msgVw"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@color/ob_ink2"
                android:textSize="15sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/prog"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="100"
                app:indicatorColor="@color/ob_accent"
                app:indicatorTrackGapSize="0dp"
                app:trackColor="@color/ob_track"
                app:trackCornerRadius="2dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/glyph_shield"
                    app:tint="@color/ob_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/splash_secure"
                    android:textColor="@color/ob_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
