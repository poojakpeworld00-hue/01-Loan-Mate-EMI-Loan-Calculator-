<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/crest"
        layout="@layout/box_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_13sdp"
            android:paddingBottom="@dimen/_12sdp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageVw"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_204sdp"
                android:background="@drawable/fill_image_well"
                android:padding="@dimen/_12sdp"
                android:scaleType="fitCenter"
                app:shapeAppearanceOverlay="@style/SH.Shape22" />

            <TextView
                android:id="@+id/nameVw"
                style="@style/SH.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:textAlignment="viewStart" />

            <GridLayout
                android:id="@+id/statsVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_minus3sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:columnCount="2" />

            <TextView
                android:id="@+id/descVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_9sdp"
                android:lineSpacingMultiplier="1.3"
                android:textAlignment="viewStart"
                android:textColor="@color/sh_text"
                android:textSize="@dimen/_11ssp" />

            <FrameLayout
                android:id="@+id/adInlineVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/downloadVw"
        style="@style/SH.Cta"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/_13sdp"
        android:layout_marginVertical="@dimen/_9sdp"
        android:text="@string/download" />

    <FrameLayout
        android:id="@+id/adSlotVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:visibility="gone" />
</LinearLayout>
