<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ln_bg_summary_card"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ln_sfprodisplaybold"
        android:text="@string/ln_ci_yearly_investment"
        android:textColor="@color/ln_text_primary"
        android:textSize="14sp" />

    <LinearLayout
        android:minHeight="52dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ln_bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_marginEnd="8dp"
            android:id="@+id/tvAmountSymbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:textColor="@color/ln_text_secondary"
            android:textSize="16sp"
            tools:text="$" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:hint="@string/ln_ci_enter_here"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/ln_sfprodisplaybold"
        android:text="@string/ln_ci_rate_of_interest"
        android:textColor="@color/ln_text_primary"
        android:textSize="14sp" />

    <LinearLayout
        android:minHeight="52dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ln_bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <EditText
            android:id="@+id/etRate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:hint="@string/ln_ci_enter_here"
            android:imeOptions="actionNext"
            android:inputType="numberDecimal"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="16sp" />

        <TextView
            android:layout_marginStart="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:text="@string/ln_calc_unit_pct_short"
            android:textColor="@color/ln_text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/ln_sfprodisplaybold"
        android:text="@string/ln_ci_time_period"
        android:textColor="@color/ln_text_primary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:minHeight="52dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <EditText
                android:id="@+id/etTenure"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:hint="@string/ln_ci_enter_here"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:textColor="@color/ln_text_primary"
                android:textColorHint="@color/ln_text_tertiary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Month / Year segmented control; active state painted by CalcInputPanel -->
        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ln_bg_segment"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/btnMonths"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:gravity="center"
                android:text="@string/ln_ci_unit_month"
                android:textColor="@color/ln_text_secondary"
                android:textSize="13sp" />

            <Space
                android:layout_width="4dp"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/btnYears"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:gravity="center"
                android:text="@string/ln_ci_unit_year"
                android:textColor="@color/ln_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Reset (light) + Calculate (filled) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_btn_light"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:gravity="center"
            android:text="@string/ln_calc_action_reset"
            android:textColor="@color/ln_brand_primary"
            android:textSize="16sp" />

        <Space
            android:layout_width="10dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/btnCalculate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="2"
            android:background="@drawable/ln_bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:gravity="center"
            android:text="@string/ln_calc_action_calculate"
            android:textColor="@color/ln_text_on_primary"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
