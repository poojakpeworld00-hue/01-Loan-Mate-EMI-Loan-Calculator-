<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ln_bg_summary_card"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Column headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:gravity="start"
            android:letterSpacing="0.04"
            android:text="@string/ln_ci_currency"
            android:textAllCaps="true"
            android:textColor="@color/ln_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:gravity="end"
            android:letterSpacing="0.04"
            android:text="@string/ln_ci_number_of_notes"
            android:textAllCaps="true"
            android:textColor="@color/ln_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="@dimen/_8sdp"
        android:background="@color/ln_divider" />

    <!-- Row template repeated 6 times: $10 / $20 / $50 / $100 / $200 / $500 -->
    <LinearLayout
        android:id="@+id/row10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:minHeight="44dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_grid_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/sym10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:text="10"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count10"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:hint="0"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:minHeight="44dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_grid_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/sym20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:text="20"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count20"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:hint="0"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row50"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:minHeight="44dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_grid_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/sym50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:text="50"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count50"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:hint="0"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row100"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:minHeight="44dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_grid_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/sym100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:text="100"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count100"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:hint="0"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row200"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:minHeight="44dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_grid_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/sym200"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:text="200"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count200"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:hint="0"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row500"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:minHeight="44dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_grid_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/sym500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:text="500"
                android:textColor="@color/ln_grid_green_fg"
                android:textSize="15sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count500"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:hint="0"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Reset (light) + Calculate (filled) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_btn_light"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:gravity="center"
            android:text="@string/ln_calc_action_reset"
            android:textColor="@color/ln_brand_primary"
            android:textSize="16sp" />

        <Space
            android:layout_width="10dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/btnCalculate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="2"
            android:background="@drawable/ln_bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:gravity="center"
            android:text="@string/ln_calc_action_calculate"
            android:textColor="@color/ln_text_on_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Total Amount footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/ln_bg_summary_headline"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:text="@string/ln_ci_total_amount"
            android:textColor="@color/ln_white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvTotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:textColor="@color/ln_white"
            android:textSize="22sp"
            tools:text="00000" />
    </LinearLayout>
</LinearLayout>
