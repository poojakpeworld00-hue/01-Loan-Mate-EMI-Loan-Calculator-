<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_14sdp"
    android:background="@drawable/ln_bg_summary_card"
    android:orientation="vertical"
    android:padding="@dimen/_14sdp">

    <!-- Column headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:gravity="center"
            android:text="@string/ln_ci_currency"
            android:textColor="@color/ln_brand_primary"
            android:textSize="@dimen/_13ssp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:gravity="center"
            android:text="@string/ln_ci_number_of_notes"
            android:textColor="@color/ln_brand_primary"
            android:textSize="@dimen/_13ssp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="@dimen/_8sdp"
        android:background="@color/ln_divider" />

    <!-- Row template repeated 6 times: $10 / $20 / $50 / $100 / $200 / $500 -->
    <LinearLayout
        android:id="@+id/row10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp">

            <TextView
                android:id="@+id/sym10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sf_pro_semibold"
                android:textColor="@color/ln_brand_primary"
                android:textSize="@dimen/_12ssp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sf_pro_medium"
                android:text="10"
                android:textColor="@color/ln_text_primary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sf_pro_medium"
            android:hint="0"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp">

            <TextView
                android:id="@+id/sym20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sf_pro_semibold"
                android:textColor="@color/ln_brand_primary"
                android:textSize="@dimen/_12ssp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sf_pro_medium"
                android:text="20"
                android:textColor="@color/ln_text_primary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count20"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sf_pro_medium"
            android:hint="0"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row50"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp">

            <TextView
                android:id="@+id/sym50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sf_pro_semibold"
                android:textColor="@color/ln_brand_primary"
                android:textSize="@dimen/_12ssp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sf_pro_medium"
                android:text="50"
                android:textColor="@color/ln_text_primary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count50"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sf_pro_medium"
            android:hint="0"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row100"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp">

            <TextView
                android:id="@+id/sym100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sf_pro_semibold"
                android:textColor="@color/ln_brand_primary"
                android:textSize="@dimen/_12ssp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sf_pro_medium"
                android:text="100"
                android:textColor="@color/ln_text_primary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count100"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sf_pro_medium"
            android:hint="0"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row200"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp">

            <TextView
                android:id="@+id/sym200"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sf_pro_semibold"
                android:textColor="@color/ln_brand_primary"
                android:textSize="@dimen/_12ssp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sf_pro_medium"
                android:text="200"
                android:textColor="@color/ln_text_primary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count200"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sf_pro_medium"
            android:hint="0"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row500"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_4sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp">

            <TextView
                android:id="@+id/sym500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sf_pro_semibold"
                android:textColor="@color/ln_brand_primary"
                android:textSize="@dimen/_12ssp"
                tools:text="$" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sf_pro_medium"
                android:text="500"
                android:textColor="@color/ln_text_primary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <EditText
            android:id="@+id/count500"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ln_bg_input_field"
            android:fontFamily="@font/ln_sf_pro_medium"
            android:hint="0"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp"
            android:textColor="@color/ln_text_primary"
            android:textColorHint="@color/ln_text_tertiary"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:background="@drawable/ln_bg_btn_primary"
        android:fontFamily="@font/ln_sf_pro_semibold"
        android:gravity="center"
        android:text="@string/ln_calc_action_calculate"
        android:textColor="@color/ln_text_on_primary"
        android:textSize="@dimen/_13ssp" />

    <TextView
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/ln_sf_pro_semibold"
        android:gravity="center"
        android:text="@string/ln_calc_action_reset"
        android:textColor="@color/ln_brand_primary"
        android:textSize="@dimen/_13ssp" />

    <!-- Total Amount footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:background="@drawable/ln_bg_summary_headline"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_12sdp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:text="@string/ln_ci_total_amount"
            android:textColor="@color/ln_brand_primary"
            android:textSize="@dimen/_13ssp" />

        <TextView
            android:id="@+id/tvTotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:textColor="@color/ln_brand_primary"
            android:textSize="@dimen/_15ssp"
            tools:text="00000" />
    </LinearLayout>
</LinearLayout>
