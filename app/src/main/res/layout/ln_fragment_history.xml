<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ln_bg_screen">

    <!-- LIST STATE: header (Recent History | N ITEMS) + RecyclerView -->
    <LinearLayout
        android:id="@+id/listGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:letterSpacing="-0.01"
                android:text="@string/ln_history_recent"
                android:textColor="@color/ln_text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvHeaderCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ln_bg_pill_light"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:letterSpacing="0.04"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/ln_brand_primary_dark"
                android:textSize="12sp"
                tools:text="2 ITEMS" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:scrollbars="none"
            tools:listitem="@layout/ln_item_history" />
    </LinearLayout>

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/emptyGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingBottom="60dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/ln_bg_circle_brand_tint"
            android:importantForAccessibility="no"
            android:padding="26dp"
            android:src="@drawable/ln_ic_nav_history"
            app:tint="@color/ln_brand_primary" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:text="@string/ln_history_empty_title"
            android:textColor="@color/ln_text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/ln_sf_pro"
            android:gravity="center"
            android:text="@string/ln_history_empty_subtitle"
            android:textColor="@color/ln_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
