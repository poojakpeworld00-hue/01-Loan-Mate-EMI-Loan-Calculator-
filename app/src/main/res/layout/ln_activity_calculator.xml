<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ln_bg_screen">

    <!-- Top bar: back + title + currency pill -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingStart="6dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/ln_action_back"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ln_ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/ln_text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:textColor="@color/ln_text_primary"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/tvCurrency"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            tools:text="Loan Calculator" />

        <TextView
            android:id="@+id/tvCurrency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ln_bg_pill_light"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/ln_brand_primary_dark"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="₹ INR"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Per-type input card is inflated into this container by LoanCalculatorActivity -->
            <FrameLayout
                android:id="@+id/inputCardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- SUMMARY (shared, hidden until first compute) -->
            <LinearLayout
                android:id="@+id/summarySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/ln_sfprodisplaybold"
                    android:text="@string/ln_calc_section_summary"
                    android:textColor="@color/ln_text_primary"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ln_bg_summary_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Blue result block -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ln_bg_summary_headline"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/lblHeadline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ln_sfprodisplaybold"
                            android:letterSpacing="0.06"
                            android:textColor="@color/ln_brand_primary_light"
                            android:textSize="12sp"
                            tools:text="ESTIMATED MONTHLY EMI" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHeadlineSymbol"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/ln_sfprodisplaybold"
                                android:textColor="@color/ln_white"
                                android:textSize="30sp"
                                tools:text="$" />

                            <TextView
                                android:id="@+id/tvHeadlineValue"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:autoSizeMaxTextSize="34sp"
                                android:autoSizeMinTextSize="16sp"
                                android:autoSizeTextType="uniform"
                                android:fontFamily="@font/ln_sfprodisplaybold"
                                android:gravity="center_vertical"
                                android:letterSpacing="-0.02"
                                android:maxLines="1"
                                android:textColor="@color/ln_white"
                                tools:text="500.91" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Donut + legend -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/donutHolder"
                            android:layout_width="120dp"
                            android:layout_height="120dp">

                            <com.loanmate.loan.emicalculator.carloan.homelloan.loan.calc.LoanDonutView
                                android:id="@+id/donut"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDonutPct"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/ln_sfprodisplaybold"
                                    android:textColor="@color/ln_text_primary"
                                    android:textSize="20sp"
                                    tools:text="18%" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/ln_sfprodisplaybold"
                                    android:letterSpacing="0.06"
                                    android:text="@string/ln_calc_chart_interest"
                                    android:textColor="@color/ln_text_secondary"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/ln_bg_legend_principal" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/ln_sf_pro_semibold"
                                android:text="@string/ln_calc_legend_principal"
                                android:textColor="@color/ln_text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="10dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/ln_bg_legend_interest" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/ln_sf_pro_semibold"
                                android:text="@string/ln_calc_legend_interest"
                                android:textColor="@color/ln_text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Label / value rows -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ln_sf_pro"
                            android:text="@string/ln_calc_breakdown_principal"
                            android:textColor="@color/ln_text_secondary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvPrincipal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ln_sfprodisplaybold"
                            android:textColor="@color/ln_text_primary"
                            android:textSize="15sp"
                            tools:text="$25,000" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ln_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ln_sf_pro"
                            android:text="@string/ln_calc_breakdown_interest"
                            android:textColor="@color/ln_text_secondary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvInterest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ln_sfprodisplaybold"
                            android:textColor="@color/ln_text_primary"
                            android:textSize="15sp"
                            tools:text="$5,054" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ln_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/ln_sf_pro"
                            android:text="@string/ln_calc_breakdown_total"
                            android:textColor="@color/ln_text_secondary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ln_sfprodisplaybold"
                            android:textColor="@color/ln_text_primary"
                            android:textSize="15sp"
                            tools:text="$30,054" />
                    </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Estimate disclaimer -->
            <TextView
                android:id="@+id/tvDisclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/ln_sf_pro"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/ln_ci_disclaimer"
                android:textColor="@color/ln_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
