<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ln_bg_screen"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingHorizontal="@dimen/_12sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_10sdp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Loan Freedom promo card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/promoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ln_bg_promo_card"
            android:padding="@dimen/_10sdp">

            <TextView
                android:id="@+id/promoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:text="@string/ln_home_promo_title"
                android:textColor="@color/ln_white"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintEnd_toStartOf="@id/progressCircle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/promoSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:fontFamily="@font/ln_sf_pro"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/ln_home_promo_subtitle"
                android:textColor="#D6E2FF"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintEnd_toStartOf="@id/progressCircle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/promoTitle" />

            <TextView
                android:id="@+id/btnPromoCta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/ln_bg_btn_white_pill"
                android:fontFamily="@font/ln_sf_pro_semibold"
                android:gravity="center"
                android:minHeight="@dimen/_34sdp"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:text="@string/ln_home_promo_cta"
                android:textColor="@color/ln_brand_primary"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/promoSubtitle" />

            <FrameLayout
                android:id="@+id/progressCircle"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_50sdp"
                android:background="@drawable/ln_bg_circle_white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/ln_sfprodisplaybold"
                    android:gravity="center"
                    android:text="@string/ln_home_promo_progress"
                    android:textColor="@color/ln_brand_primary"
                    android:textSize="@dimen/_13ssp" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Calculators section heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:text="@string/ln_home_section_calcs"
            android:textColor="@color/ln_text_primary"
            android:textSize="@dimen/_15ssp" />

        <!-- 2x2 calc tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileEmi"
                layout="@layout/ln_item_calc_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space
                android:layout_width="@dimen/_10sdp"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/tileBusiness"
                layout="@layout/ln_item_calc_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileAuto"
                layout="@layout/ln_item_calc_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space
                android:layout_width="@dimen/_10sdp"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/tileHomeLoan"
                layout="@layout/ln_item_calc_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Banking calculators card -->
        <LinearLayout
            android:id="@+id/bankingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/ln_bg_banking_card"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ln_home_bankinglogo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ln_sfprodisplaybold"
                            android:text="@string/ln_home_banking_title_1"
                            android:textColor="@color/ln_brand_primary"
                            android:textSize="@dimen/_15ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:fontFamily="@font/ln_sfprodisplaybold"
                            android:text="@string/ln_home_banking_title_2"
                            android:textColor="@color/ln_text_primary"
                            android:textSize="@dimen/_15ssp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:fontFamily="@font/ln_sf_pro"
                        android:lineSpacingMultiplier="1.3"
                        android:text="@string/ln_home_banking_subtitle"
                        android:textColor="@color/ln_text_secondary"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/ln_line_img" />

            <!-- Row 1: 4 grid items -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/gridRd"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridFd"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridRoi"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridPpf"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Row 2: 4 grid items -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/gridCompound"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridCash"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridQuiz"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridPlay"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
