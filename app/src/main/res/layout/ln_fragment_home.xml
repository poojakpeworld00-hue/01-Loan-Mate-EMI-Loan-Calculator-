<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ln_bg_screen"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:padding="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ln_sf_pro_semibold"
            android:text="@string/ln_home_brand_name"
            android:textColor="@color/ln_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:letterSpacing="-0.01"
            android:text="@string/ln_home_brand_title"
            android:textColor="@color/ln_text_primary"
            android:textSize="22sp" />

        <!-- Loan Freedom promo card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/promoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/ln_bg_promo_card"
            android:clipToOutline="true"
            android:padding="18dp">

            <View
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/ln_bg_promo_bubble"
                android:importantForAccessibility="no"
                android:translationX="58dp"
                android:translationY="-68dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/promoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:text="@string/ln_home_promo_title"
                android:textColor="@color/ln_white"
                android:textSize="17sp"
                app:layout_constraintEnd_toStartOf="@id/progressCircle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/promoSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/ln_sf_pro"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/ln_home_promo_subtitle"
                android:textColor="@color/ln_brand_primary_light"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/progressCircle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/promoTitle" />

            <TextView
                android:id="@+id/btnPromoCta"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/ln_bg_btn_white_pill"
                android:fontFamily="@font/ln_sfprodisplaybold"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/ln_home_promo_cta"
                android:textColor="@color/ln_brand_primary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/promoSubtitle" />

            <!-- Progress ring -->
            <FrameLayout
                android:id="@+id/progressCircle"
                android:layout_width="84dp"
                android:layout_height="84dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:indeterminate="false"
                    android:max="100"
                    android:maxHeight="84dp"
                    android:maxWidth="84dp"
                    android:minHeight="84dp"
                    android:minWidth="84dp"
                    android:progress="75"
                    android:progressBackgroundTint="@color/ln_white_25"
                    android:progressDrawable="@drawable/ln_progress_ring"
                    android:progressTint="@color/ln_white" />

                <TextView
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ln_bg_circle_white"
                    android:fontFamily="@font/ln_sfprodisplaybold"
                    android:gravity="center"
                    android:text="@string/ln_home_promo_progress"
                    android:textColor="@color/ln_brand_primary"
                    android:textSize="18sp" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Calculators section heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/ln_sfprodisplaybold"
            android:text="@string/ln_home_section_calcs"
            android:textColor="@color/ln_text_primary"
            android:textSize="18sp" />

        <!-- 2x2 calc tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileEmi"
                layout="@layout/ln_item_calc_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/tileBusiness"
                layout="@layout/ln_item_calc_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileAuto"
                layout="@layout/ln_item_calc_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/tileHomeLoan"
                layout="@layout/ln_item_calc_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Banking calculators panel -->
        <LinearLayout
            android:id="@+id/bankingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/ln_bg_banking_card"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ln_sfprodisplaybold"
                    android:text="@string/ln_home_banking_title_1"
                    android:textColor="@color/ln_brand_primary"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/ln_sfprodisplaybold"
                    android:text="@string/ln_home_banking_title_2"
                    android:textColor="@color/ln_text_primary"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/ln_sf_pro"
                android:text="@string/ln_home_banking_subtitle"
                android:textColor="@color/ln_text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="12dp"
                android:background="@color/ln_divider" />

            <!-- Row 1: 4 grid items -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/gridRd"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridFd"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridRoi"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridPpf"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Row 2: 4 grid items -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/gridCompound"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridCash"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridQuiz"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/gridPlay"
                    layout="@layout/ln_item_banking_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
