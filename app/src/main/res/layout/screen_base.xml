<?xml version="1.0" encoding="utf-8"?>
<!-- Home: the loan tabs (home, tools, history, settings) over the pinned bottom ad and the tab bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ob_bg">

    <LinearLayout
        android:id="@+id/screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/tabHostVw"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- bottom_ad: pinned, full width, no margin. -->
        <FrameLayout
            android:id="@+id/adSlotVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <include
            android:id="@+id/navBarVw"
            layout="@layout/ln_bottom_nav" />
    </LinearLayout>
</FrameLayout>
