<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/base_holderIxVw"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/state_scrimIxVw"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/hpd_state_scrim" />

    <include
        android:id="@+id/main_show_gridIxVw"
        layout="@layout/hp_home_show_grid" />

    <include
        android:id="@+id/all_apps_blockIxVw"
        layout="@layout/hp_all_apps_zone"
        android:visibility="gone" />

    <include
        android:id="@+id/widgets_blockIxVw"
        layout="@layout/hp_gadgets_zone"
        android:visibility="gone" />

    <include
        android:id="@+id/start_pageIxVw"
        layout="@layout/hp_side_scr_zone"
        android:visibility="gone" />

    <include
        android:id="@+id/msgs_pageIxVw"
        layout="@layout/hp_messages_scr_zone"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/swipe_hintIxVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#be000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/swipe_hint_chevronsIxVw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/swipe_hint_chevron_1IxVw"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:alpha="0.3"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right_vector"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/swipe_hint_chevron_2IxVw"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right_vector"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/swipe_hint_chevron_3IxVw"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right_vector"
                android:tint="@android:color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/swipe_hint_textIxVw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/launcher_swipe_right_hint"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.7"
            android:gravity="center"
            android:text="@string/launcher_swipe_hint_tap"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:id="@+id/main_show_dialog_opts_pinIxVw"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</RelativeLayout>
